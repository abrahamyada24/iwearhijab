# Salin menjadi keystore.properties dan isi dengan kredensial lokal.
# Jangan commit keystore.properties atau file release ke Git.
# storeFile relatif terhadap android/app; path absolut boleh memakai slash /.
storeFile=iwear-release.keystore
storePassword=GANTI_DENGAN_PASSWORD_KUAT
keyAlias=iwear
keyPassword=GANTI_DENGAN_PASSWORD_KUAT
