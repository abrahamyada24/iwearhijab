NODE_ENV=production
HOST=0.0.0.0
PORT=5200

# TiDB Cloud: salin host/user dari panel Connect, URL-encode username/password.
# Pool kecil untuk instance serverless Vercel; TLS tetap strict.
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/iwear?sslaccept=strict&connection_limit=1&pool_timeout=20"
JWT_SECRET="CHANGE_WITH_A_LONG_RANDOM_SECRET"
LICENSE_CODE_SECRET="CHANGE_WITH_A_SEPARATE_LONG_RANDOM_SECRET"

# Super Admin platform. Akun pertama dibuat saat login pertama jika tabel admin masih kosong.
# Gunakan password minimal 12 karakter dan simpan ketiganya sebagai Secret di Vercel.
PLATFORM_ADMIN_NAME="Pengelola Iwearing Hijab"
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="CHANGE_WITH_A_STRONG_PLATFORM_PASSWORD"
PLATFORM_ADMIN_JWT_SECRET="CHANGE_WITH_ANOTHER_LONG_RANDOM_SECRET"

# Inisialisasi pemilik toko. Seed tidak pernah menimpa password user yang sudah ada.
SEED_OWNER_PASSWORD="CHANGE_WITH_A_STRONG_OWNER_PASSWORD"

# Pisahkan dengan koma. Wildcard opsional, contoh: https://*.vercel.app
CORS_ORIGINS="https://YOUR_PROJECT.pages.dev"

# Opsional untuk development/self-hosted. Di Vercel gunakan Cloudinary di bawah.
UPLOAD_DIR=""
ENABLE_API_DOCS=false

# Ketiganya wajib diisi pada backend Vercel; jangan taruh secret di Cloudflare/frontend.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="iwear"

# Opsional. Biarkan kosong bila payment gateway belum digunakan.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false

# Opsional untuk OTP/email.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"Iwearing Hijab" <noreply@YOUR_DOMAIN>'


# Instalasi dedicated: pendaftaran usaha publik nonaktif.
PUBLIC_BUSINESS_REGISTRATION=false
SEED_OWNER_EMAIL=""
