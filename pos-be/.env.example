NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# MySQL kompatibel. Untuk demo tanpa VPS, TiDB Cloud Starter dapat dipakai.
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DATABASE?sslaccept=strict"
JWT_SECRET="CHANGE_WITH_A_LONG_RANDOM_SECRET"
LICENSE_CODE_SECRET="CHANGE_WITH_A_SEPARATE_LONG_RANDOM_SECRET"

# Hanya dibutuhkan saat npm run seed pertama kali. Seed tidak pernah menimpa password user yang sudah ada.
SEED_OWNER_PASSWORD="CHANGE_WITH_A_STRONG_OWNER_PASSWORD"
SEED_ADMIN_PASSWORD="CHANGE_WITH_A_STRONG_ADMIN_PASSWORD"
SEED_CASHIER_PASSWORD="CHANGE_WITH_A_STRONG_CASHIER_PASSWORD"
SEED_REQUIRE_PASSWORD_CHANGE=false

# Pisahkan dengan koma. Wildcard opsional, contoh: https://*.vercel.app
CORS_ORIGINS="https://YOUR_PROJECT.pages.dev"

# Opsional untuk development/self-hosted. Di Render gunakan Cloudinary di bawah.
UPLOAD_DIR=""
ENABLE_API_DOCS=false

# Direkomendasikan pada hosting dengan filesystem sementara (mis. Render free).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Opsional. Biarkan kosong bila payment gateway belum digunakan.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false

# Opsional untuk OTP/email.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
