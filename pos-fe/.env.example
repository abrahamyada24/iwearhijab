# Biarkan kosong: browser memakai /api di origin sendiri (cookie first-party).
# Development memakai rewrite Next.js; Cloudflare memakai Pages Functions.
NEXT_PUBLIC_API_URL=
STATIC_EXPORT=true

# Runtime binding Pages Functions; arahkan ke backend Vercel tanpa akhiran /api.
API_PROXY_TARGET=https://api.iwear.example
